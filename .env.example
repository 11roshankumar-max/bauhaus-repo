# Copy this file to .env and fill in what you have.
# Nothing here is required to run the site in demo mode — see README.md.

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000

# --- Stripe (test mode) ---
# Leave both blank to run in MOCK/DEMO payment mode (orders are marked "paid"
# instantly with no real payment, useful for testing the flow end-to-end).
# Get test keys free at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Only needed once you wire up a real webhook endpoint (see README, "Going live").
STRIPE_WEBHOOK_SECRET=

# --- Outgoing email (order confirmations) ---
# Leave SMTP_HOST blank to just log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@taanabaana.example

# --- Admin dashboard (HTTP Basic Auth) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# --- Shipping (Shiprocket) ---
# Leave SHIPROCKET_EMAIL blank to get a flat, weight-tiered shipping estimate
# instead of real courier rates (useful for testing the flow end-to-end).
# Create an API user under Shiprocket dashboard > Settings > API.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Postcode of your pickup/warehouse location, required for real rate quotes.
SHIPROCKET_PICKUP_PINCODE=
